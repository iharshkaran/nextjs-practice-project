<% layout("/layout/boilerplate") %>

<!-- Footer hide karne ke liye -->
<style>
  .my-footer {
    display: none !important;
  }
</style>

<div class="row justify-content-center align-items-center mt-4 mb-5">
  <div class="col-11 col-sm-8 col-md-6 col-lg-4">
    
    <!-- Clean Card Wrapper -->
    <div class="card rounded-4 p-3">
      <div class="card-body">
        
        <h3 class="fw-bold mb-1 text-center">Welcome to WanderLust</h3>
        <p class="text-muted text-center fs-6 mb-4">Create your account to get started</p>
        
        <form action="/signup" method="POST" class="needs-validation" novalidate>
          
          <!-- Username -->
          <div class="mb-3">
            <label for="username" class="form-label fw-semibold text-secondary">Username</label>
            <input 
              type="text" 
              name="username" 
              id="username" 
              class="form-control form-control-lg fs-6 rounded-3" 
              placeholder="e.g. jack" 
              required 
            />
            <div class="invalid-feedback">Please enter a username.</div>
          </div>

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label fw-semibold text-secondary">Email address</label>
            <input 
              type="email" 
              name="email" 
              id="email" 
              class="form-control form-control-lg fs-6 rounded-3" 
              placeholder="name@example.com" 
              required 
            />
            <div class="invalid-feedback">Please enter a valid email.</div>
          </div>

          <!-- Password -->
          <div class="mb-4">
            <label for="password" class="form-label fw-semibold text-secondary">Password</label>
            <input 
              type="password" 
              name="password" 
              id="password" 
              class="form-control form-control-lg fs-6 rounded-3" 
              placeholder="Create a password" 
              required 
            />
            <div class="invalid-feedback">Please enter a password.</div>
          </div>

          <!-- Submit Button -->
          <button class="btn btn-danger btn-lg w-100 fw-bold rounded-3 py-2 fs-6 shadow-sm">
            Sign Up
          </button>
        </form>

        <!-- Login Link -->
        <div class="text-center mt-4 pt-2 border-top">
          <p class="text-muted fs-6 mb-0">
            Already have an account? <a href="/login" class="text-danger fw-semibold text-decoration-none">Log in</a>
          </p>
        </div>

      </div>
    </div>

  </div>
</div>