<% layout("/layout/boilerplate") %>

  <div class="row mt-4 mb-5">
    <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">

      <!-- Title -->
      <h3 class="fw-bold mb-3">
        <%= listing.title %>
      </h3>

      <!-- Listing Card Container -->
      <div class="card listing-card show-card border-0">

        <!-- Image Showcase -->
        <div class="show-img-wrapper mb-3">
          <img src="<%= listing.image.url %>" class="card-img-top show-img rounded-4" alt="listing_image"
            style="height: 22rem; object-fit: cover; width: 100%;">
        </div>

        <!-- Card Details -->
        <div class="card-body p-0">
          <p class="card-text text-muted mb-2">
            <i class="fa-solid fa-location-dot me-1 text-danger"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>

          <p class="card-text fs-5 fw-normal mb-3">
            <%= listing.description %>
          </p>

          <p class="card-text fs-4 fw-bold mb-4">
            &#8377; <%= listing.price.toLocaleString("en-IN") %>
              <span class="fs-6 text-muted fw-normal">/ night</span>
          </p>
        </div>

      </div>

      <!-- Action Buttons Row -->
      <div class="d-flex align-items-center gap-3 mt-2">
        <!-- Edit Button -->
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 py-2 fw-semibold"
          style="background-color: #fe424d; border: none;">
          Edit
        </a>

        <!-- Delete Form Button -->
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
          <button class="btn btn-outline-dark px-4 py-2 fw-semibold">
            Delete
          </button>
        </form>
      </div>

      <hr class="my-4" />


      <!-- Reviews -->
      <div class="mb-4">
        <h4 class="fw-bold mb-3">Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

          <!-- Rating Slider -->
          <div class="mb-2 col-4">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" />
          </div>

          <!-- Comment Area -->
          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Comments</label>
            <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control"
              placeholder="Write your experience..." required></textarea>
            <div class="invalid-feedback">Please add some comments for review.</div>
          </div>

          <!-- Submit Button -->
          <button class="btn btn-outline-dark fw-semibold">Submit</button>
        </form>
      </div>


      <!-- All Reviews -->
      <p class="fw-bold fs-5 mb-3">All Reviews</p>

      <div class="row row-cols-1 row-cols-md-2 g-3 mb-3">
        <% for(review of listing.reviews) { %>
          <div class="col">
            <div class="card h-100 border p-3 rounded-3 shadow-sm">
              <div class="card-body p-0">
                <h6 class="card-title fw-bold text-dark mb-1">Jane Doe</h6>
                <p class="card-text text-muted mb-2">
                  <%= review.comment %>
                </p>
                <p class="card-text fw-semibold text-warning mb-3">
                  <%= review.rating %> &#9733;
                </p>
              </div>

              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                class="mt-auto">
                <button class="btn btn-sm btn-outline-danger px-3 fw-semibold">Delete</button>
              </form>
            </div>
          </div>
          <% } %>
      </div>
    </div>
  </div>