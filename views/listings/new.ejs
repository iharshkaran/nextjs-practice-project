<% layout("/layout/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <h3 class="mb-4 fw-bold">Create a New Listing</h3>

    <!-- enctype="multipart/form-data" is mandatory for file uploads -->
    <form method="POST" action="/listings" enctype="multipart/form-data" class="needs-validation" novalidate>
      
      <!-- Title -->
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" id="title" placeholder="Add a catchy title" type="text" class="form-control" required />
        <div class="valid-feedback">Title looks great!</div>
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea name="listing[description]" id="description" placeholder="Describe your place..." class="form-control" rows="4" required></textarea>
        <div class="valid-feedback">Description looks good!</div>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <!-- File Upload Input for Cloudinary -->
      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
        <input name="listing[image]" id="image" type="file" class="form-control" required />
        <div class="valid-feedback">Image file attached!</div>
        <div class="invalid-feedback">Please upload an image file.</div>
      </div>

      <!-- Price & Country (Side by Side Grid) -->
      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label fw-semibold">Price</label>
          <input name="listing[price]" id="price" placeholder="1200" type="number" class="form-control" required />
          <div class="valid-feedback">Price set!</div>
          <div class="invalid-feedback">Price should be a valid number.</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" id="country" placeholder="India" type="text" class="form-control" required />
          <div class="valid-feedback">Country name verified!</div>
          <div class="invalid-feedback">Country name is required.</div>
        </div>
      </div>

      <!-- Location -->
      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location</label>
        <input name="listing[location]" id="location" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required />
        <div class="valid-feedback">Location looks correct!</div>
        <div class="invalid-feedback">Location should be valid.</div>
      </div>

      <!-- Submit Button -->
      <button class="btn btn-dark w-100 py-2 mt-3 text-uppercase fw-bold" style="background-color: #fe424d; border: none;">Add Listing</button>

    </form>
  </div>
</div>