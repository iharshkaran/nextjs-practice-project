<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WanderLust — Find Your Next Stay</title>
  <link rel="icon" href="https://api.iconify.design/fa6-regular:compass.svg?color=%23fe424d" type="image/svg+xml">
  
  <!-- Bootstrap & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

  <!-- Modular Custom CSS -->
  <link rel="stylesheet" href="/css/landing.css" />
</head>
<body>

  <div class="glow-blob-1"></div>

  <!-- Header with Listing-style Margins -->
  <header class="container">
    <nav class="landing-nav navbar d-flex align-items-center justify-content-between flex-nowrap position-relative z-1">
      <a href="/" class="navbar-brand d-flex align-items-center gap-2 text-dark fw-bold fs-5 m-0 p-0">
        <i class="fa-regular fa-compass text-danger fs-4"></i>
        <span class="brand-text">WanderLust</span>
      </a>
      <div class="d-flex align-items-center gap-2">
        <a href="/login" class="text-secondary text-decoration-none fw-semibold small px-2">Log In</a>
        <a href="/signup" class="btn btn-sm btn-danger rounded-pill px-3 py-1.5 fw-bold nav-btn">Sign Up</a>
      </div>
    </nav>
  </header>

  <!-- Split Hero Main Content -->
  <main class="container my-auto py-4 py-lg-5 position-relative z-1">
    <div class="row align-items-center justify-content-between g-4 g-lg-5">
      
      <!-- Left Column -->
      <div class="col-12 col-lg-6 text-center text-lg-start">
        <span class="badge badge-glass rounded-pill px-3 py-2 fw-semibold mb-3 d-inline-flex align-items-center gap-2">
          <i class="fa-solid fa-sparkles"></i> Redefining Your Travel Stays
        </span>

        <h1 class="display-4 fw-bold text-dark hero-title mb-3 lh-sm">
          Find your next stay with ease.
        </h1>

        <p class="text-secondary fs-5 mb-4 fw-normal lh-base">
          Discover handpicked villas, luxury beachfront homes, and cozy mountain cabins around the world.
        </p>

        <div class="d-flex flex-column flex-sm-row align-items-center gap-3 mb-4">
          <a href="/listings" class="btn btn-brand-hero btn-lg px-4 py-3 rounded-pill fw-bold fs-6 d-inline-flex align-items-center justify-content-center gap-2">
            Explore All Listings <i class="fa-solid fa-arrow-right-long"></i>
          </a>
        </div>

        <!-- Metrics -->
        <div class="d-flex align-items-center justify-content-center justify-content-lg-start gap-4 pt-2 border-top border-slate-200">
          <div>
            <h5 class="fw-bold mb-0 text-dark">500+</h5>
            <span class="text-secondary small">Verified Stays</span>
          </div>
          <div class="vr opacity-25"></div>
          <div>
            <h5 class="fw-bold mb-0 text-dark">4.9 ★</h5>
            <span class="text-secondary small">Guest Rating</span>
          </div>
        </div>
      </div>

      <!-- Right Column -->
      <div class="col-12 col-lg-6">
        <div class="position-relative">
          <img 
            src="https://images.unsplash.com/photo-1512917774080-9991f1c4c750?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80" 
            class="hero-img-main" 
            alt="Luxury Villa" 
          />
          
          <div class="glass-floating-card d-flex align-items-center gap-3">
            <div class="bg-danger text-white rounded-circle p-2.5 d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
              <i class="fa-solid fa-house-circle-check fs-6"></i>
            </div>
            <div>
              <h6 class="fw-bold mb-0 text-dark fs-6">Beachfront Villa</h6>
              <span class="text-secondary small">Malibu, United States</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Feature Cards Section -->
    <div class="row g-3 g-md-4 mt-4 mt-lg-5 justify-content-center">
      <div class="col-12 col-md-4">
        <div class="feature-card p-4 text-start h-100">
          <div class="text-danger fs-4 mb-2"><i class="fa-solid fa-shield-halved"></i></div>
          <h6 class="fw-bold text-dark mb-1">Verified Stays</h6>
          <p class="text-secondary small mb-0">Every property on WanderLust is manually reviewed for location accuracy and host safety.</p>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="feature-card p-4 text-start h-100">
          <div class="text-danger fs-4 mb-2"><i class="fa-solid fa-map-location-dot"></i></div>
          <h6 class="fw-bold text-dark mb-1">Interactive Maps</h6>
          <p class="text-secondary small mb-0">Explore neighborhood places and exact stay locations directly using our integrated maps.</p>
        </div>
      </div>

      <div class="col-12 col-md-4">
        <div class="feature-card p-4 text-start h-100">
          <div class="text-danger fs-4 mb-2"><i class="fa-solid fa-star"></i></div>
          <h6 class="fw-bold text-dark mb-1">Real Reviews</h6>
          <p class="text-secondary small mb-0">Read authentic experiences and ratings shared directly by verified community travelers.</p>
        </div>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="container text-center py-3 text-secondary small position-relative z-1 border-top border-slate-200">
    © 2026 WanderLust Inc. All rights reserved.
  </footer>

</body>
</html>